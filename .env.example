# Copy to .env and fill in. .env is gitignored — never commit it.

# Anthropic API key for the narrative + divergence LLM calls.
ANTHROPIC_API_KEY=sk-ant-...

# Required only if your key is "identity-linked" (the API returns
# "anthropic-workspace-id is required"). Find it in the Anthropic console under
# Settings -> Workspaces (the id looks like wrkspc_...).
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional: force Kronos onto a specific device (mps | cpu | cuda).
# Leave unset for auto-detect (mps on Apple Silicon, else cpu).
# KRONOS_DEVICE=cpu

# Optional: model ids (defaults are fine).
# ANTHROPIC_MODEL=claude-sonnet-5
# KRONOS_MODEL=NeoQuasar/Kronos-small
# KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
