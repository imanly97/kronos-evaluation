<?xml version="1.0" encoding="UTF-8"?>
<!-- Local backup scheduler. Primary is GitHub Actions (.github/workflows/nightly.yml).
     Install:  cp scheduling/*.plist ~/Library/LaunchAgents/
               launchctl load ~/Library/LaunchAgents/com.forecastdesk.postclose.plist
     Edit WorkingDirectory / ProgramArguments paths to match your machine.
     Runs after the close: grade the forecast that just settled + post-mortem,
     which writes the desk memory the next premarket reads back. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forecastdesk.postclose</string>
  <key>WorkingDirectory</key>
  <string>/Users/isaac/Desktop/foundation_model_desk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/isaac/Desktop/foundation_model_desk/.venv/bin/python</string>
    <string>-m</string>
    <string>src.run_daily</string>
    <string>postclose</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>16</integer>
    <key>Minute</key><integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/isaac/Desktop/foundation_model_desk/log/launchd.postclose.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/isaac/Desktop/foundation_model_desk/log/launchd.postclose.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
  </dict>
</dict>
</plist>
